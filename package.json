{
  "name": "wb-checkin",
  "private": true,
  "version": "0.10.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:build": "tauri build",
    "app:build:dist": "tauri build --bundles app && codesign --force --deep --sign - \"src-tauri/target/release/bundle/macos/WB-Checkin.app\" && ditto -c -k --keepParent \"src-tauri/target/release/bundle/macos/WB-Checkin.app\" \"src-tauri/target/release/bundle/WB-Checkin-adhoc.zip\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
